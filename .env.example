# AgentMail (https://console.agentmail.to)
AGENTMAIL_API_KEY=
AGENTMAIL_ADDRESS=regulatory_research@agentmail.to

# OpenRouter, used by request_parser to interpret the email
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b

# Optional
# PARSER=llm            # "llm" (default, falls back to regex on failure) or "regex"
# HEADLESS=1            # set 0 to watch the browser
# UARB_PROXY=           # e.g. http://user:pass@host:port, if a Canadian exit IP is needed
# WORK_DIR=/tmp/uarb    # downloads and ZIPs are written under here
# MAX_REQUESTS_PER_HOUR=10   # per sender
